# ---- App ----
# local | test | production
ENVIRONMENT=local
DEBUG=false
# Optional path prefix for all routes (empty in dev; Next.js rewrites /api/* -> backend root)
API_PREFIX=

# ---- Database ----
# asyncpg URL. Local docker-compose uses the value below; Neon: postgresql+asyncpg://USER:PASS@HOST/DB?ssl=require
DATABASE_URL=postgresql+asyncpg://backend_city:backend_city@localhost:5452/backend_city
DB_ECHO=false

# ---- Auth ----
# Long random string. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# false for plain-http localhost; true in production
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Browser-visible path for the refresh cookie (frontend proxies /api/* to backend)
REFRESH_COOKIE_PATH=/api/auth

# ---- Rate limits (slowapi syntax) ----
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10/minute
CHECKPOINT_RATE_LIMIT=20/minute

# ---- Real client IP behind the Vercel proxy (same value as PROXY_SHARED_SECRET on Vercel) ----
# Empty = rate limits key on the socket peer (fine locally; on Render that is Vercel).
PROXY_SHARED_SECRET=

# ---- CORS (JSON list; only for direct browser calls, prod uses same-origin rewrites) ----
CORS_ORIGINS=["http://localhost:3000"]

# ---- Grading sandbox ----
# Learner code budget (starts after imports) and the separate interpreter/import allowance
SANDBOX_TIMEOUT_SECONDS=4
SANDBOX_STARTUP_SECONDS=20
SANDBOX_MEMORY_LIMIT_MB=256
SANDBOX_MAX_SNIPPET_CHARS=4000
# Pre-imported fork server: grades in ~1 s instead of ~10 s on small CPUs (false = cold runs)
SANDBOX_WARM=true
# Python used by the sandbox; Docker image sets /opt/harness-venv/bin/python. Empty = current.
SANDBOX_PYTHON=
